# Postgres (local dev, or Neon/Alibaba ApsaraDB in the cloud)
DATABASE_URL="postgresql://user@localhost:5432/eduos"

# Signing key for the session cookie
AUTH_SECRET="change-me"

# AI. Set AI_ENABLED=false to force deterministic non-AI fallbacks everywhere.
AI_ENABLED="true"
# Alibaba Model Studio (DashScope), OpenAI-compatible mode:
LLM_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
LLM_API_KEY=""
LLM_MODEL="qwen-plus"
